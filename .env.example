# NebulaStream control plane configuration
WORKER_US_EAST_URL=https://nebula-us.nebulastream.workers.dev
WORKER_EU_WEST_URL=https://nebula-eu.nebulastream.workers.dev
WORKER_AP_SOUTH_URL=https://nebula-apac.nebulastream.workers.dev

POLL_INTERVAL_SEC=5
BREACH_THRESHOLD_MS=200
RATE_LIMIT_SEC=30
MIN_WEIGHT=5

# Ollama (override to ollama:11434 when running in docker-compose)
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_EMBEDDINGS_URL=http://host.docker.internal:11434/api/embeddings
OLLAMA_MODEL=llama3.2

# Milvus
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
COLLECTION=incidents
VECTOR_DIM=3072

# Cloudflare (for IaC + chaos)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_PORT=8000
