{
  "title": "NebulaStream — Edge Traffic Control",
  "uid": "nebulastream-main",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Region p95 latency (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "nebula_region_p95_ms", "legendFormat": "{{region}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 200 }
      ]}}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Traffic weights (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "nebula_region_weight_pct", "legendFormat": "{{region}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total breaches",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum by (region) (increase(nebula_breaches_total[1h]))", "legendFormat": "{{region}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Shifts (last 1h)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [
        { "expr": "sum by (outcome) (increase(nebula_shifts_total[1h]))", "legendFormat": "{{outcome}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM call latency (p95)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(nebula_llm_latency_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }}
    },
    {
      "id": 6,
      "type": "heatmap",
      "title": "Recovery duration heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "sum by (le) (rate(nebula_recovery_seconds_bucket[5m]))", "format": "heatmap", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Region status (0=warming,1=healthy,2=degraded,3=breach)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "nebula_region_status", "legendFormat": "{{region}}", "refId": "A" }
      ]
    }
  ]
}
